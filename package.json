{
  "name": "rate-limited-api-gateway",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && copyfiles -u 1 src/**/*.lua dist/",
    "start": "node dist/index.js",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "docker:up": "docker compose up",
    "docker:up:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "docker:up:services": "docker compose -f docker-compose.services.yml up",
    "docker:down": "docker compose down",
    "docker:down:clean": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:logs:node": "docker compose logs -f node_server",
    "docker:build": "docker compose build",
    "docker:migrate": "docker compose exec node_server pnpm migrate",
    "docker:seed": "docker compose exec node_server pnpm seed",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "k6:run": "docker run --rm -v ./scripts:/scripts --network rate-limited-api-gateway_default grafana/k6:latest run",
    "k6:test": "docker run --rm -v ./scripts:/scripts --network rate-limited-api-gateway_default grafana/k6:latest run /scripts/test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.15.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
