# Environment variables for Docker Compose setup

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gateway_db
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=default_secure_pass

# Node.js Server
PORT=3000
DATABASE_URL=postgresql://user:password@postgres_db:5432/gateway_db
REDIS_URL=redis://:default_secure_pass@redis_cache:6379

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=5
POLICY_CACHE_REFRESH_MS=30000
